# Environment Configuration for Modive App
# Copy this file to .env and fill in the actual values
# Contact "tiennguyen" to get the required environment variables

# ==================== DATABASE & AUTHENTICATION ====================
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==================== SEO & METADATA ====================
# Base URL for your application (used for SEO, Open Graph, sitemaps)
# For production: https://moit.chat
# For staging: https://stag.moit.chat
# For development: http://localhost:3000
NEXT_PUBLIC_BASE_URL=

# ==================== DEVELOPMENT ====================
# Node Environment (development, production)
NODE_ENV=

# =============== CHATBOT CONFIGURATION ============================
X_API_ID=
X_API_KEY=
DIT_API_BASE_URL=
DIT_CHATBOT_UNIVERSE_ID=
DIT_CHATBOT_BUNDLE_ID=
DIT_CHATBOT_NAME=
DIT_CHATBOT_ID=

# =============== OAUTH2 CONFIGURATION ============================
NEXT_PUBLIC_KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# =============== NOTIFICATION ============================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# =============== TOSS PAYMENTS ===========================
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
